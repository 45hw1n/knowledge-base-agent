PORT=5000
NODE_ENV=local

MONGO_URI=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PUBSUB_PROJECT_ID=
PUBSUB_TOPIC_NAME=
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT_EMAIL=

ENCRYPTION_KEY=
EMAIL_ENCRYPTION_KEY=
SESSION_SECRET=

AI_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=

CLIENT_URL=
BACKEND_BASE_URL=
GOOGLE_AUTH_BASE_URL=

COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
SESSION_MAX_AGE=604800000
TRUST_PROXY=1
SESSION_DEBUG=false

# Storage (provider-agnostic; currently supports "cloudflare-r2")
STORAGE_PROVIDER=cloudflare-r2

# Required when STORAGE_PROVIDER=cloudflare-r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional — derived automatically from R2_ACCOUNT_ID if left blank
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# WhatsApp Cloud API (Milestone 1 — webhook receive + echo reply)
# Meta Developer → WhatsApp → API Setup / Configuration
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
